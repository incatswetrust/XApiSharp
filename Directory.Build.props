<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Early, incomplete coverage per spec section 21.2 versioning table. -->
    <Version>0.1.0-alpha.1</Version>

    <Authors>TODO-set-real-author</Authors>
    <Company>TODO-set-real-owner</Company>
    <PackageProjectUrl>https://github.com/incatswetrust/XApiSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/incatswetrust/XApiSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Spec section 21.1: "add SourceLink and a portable PDB, ship a .snupkg" -
         PublishRepositoryUrl/EmbedUntrackedSources are what make the Microsoft.SourceLink.GitHub
         package reference (added per-package below) actually take effect; portable PDB is already
         the SDK-style default, stated explicitly here so it isn't silently relied upon. -->
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

</Project>
