<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Full coverage achieved (190/190 operations implemented + contract-tested, spec 21.2's
         "full coverage, stabilization" trigger) - live validation and NuGet ownership are still
         pending, so this is a beta, not yet a release candidate.
         beta.2: new compatible feature since beta.1 (persistent rate-limit state, RATE-03/04/05 -
         issue #15) plus the E10 final handoff report - no breaking change, so the beta line
         increments rather than resetting. -->
    <Version>1.0.0-beta.2</Version>

    <Authors>Oleksii Chaikovskyi</Authors>
    <Company>Incatswetrust</Company>
    <PackageProjectUrl>https://github.com/incatswetrust/XApiSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/incatswetrust/XApiSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Spec section 21.1: "add SourceLink and a portable PDB, ship a .snupkg" -
         PublishRepositoryUrl/EmbedUntrackedSources are what make the Microsoft.SourceLink.GitHub
         package reference (added per-package below) actually take effect; portable PDB is already
         the SDK-style default, stated explicitly here so it isn't silently relied upon. -->
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

</Project>
