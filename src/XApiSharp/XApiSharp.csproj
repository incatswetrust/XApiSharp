<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>XApiSharp</PackageId>
    <Description>Independent, community-maintained C#/.NET SDK for the public X API v2. Not affiliated with or endorsed by X Corp.</Description>
    <PackageTags>x;twitter;api;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
