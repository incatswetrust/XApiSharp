<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>XApiSharp.Net</PackageId>
    <Description>Independent, community-maintained C#/.NET SDK for the public X API v2. Not affiliated with or endorsed by X Corp.</Description>
    <PackageTags>x;twitter;api;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Spec 21.2: shape validation now; once a stable package exists, set
         PackageValidationBaselineVersion to it (also enables the compat, not just shape, checks). -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
